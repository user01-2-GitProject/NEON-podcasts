# Copy to mobile/.env.local for local development; set real values as EAS
# secrets for release builds. Never commit real credentials or DSNs.

# API base URL used by lib/config.ts (falls back to app.json extra.apiUrl).
EXPO_PUBLIC_API_URL="https://neon-podcasts.vercel.app"
# Optional override for legal-page links (falls back to EXPO_PUBLIC_API_URL).
EXPO_PUBLIC_WEB_URL=""

# Google OAuth client IDs used by native sign-in.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""

# ---- Error reporting (Sentry, free tier: 5k events/month) ----
# Create a Sentry project for the mobile app and paste its DSN here (as an EAS
# secret for release builds). Sentry stays off unless NODE_ENV=production and
# this value is set. A DSN is public, but leave this example empty.
EXPO_PUBLIC_SENTRY_DSN=""

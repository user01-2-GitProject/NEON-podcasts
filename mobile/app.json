{
  "expo": {
    "name": "NEON",
    "slug": "neon-podcasts",
    "scheme": "neonpodcasts",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.needlesslyengineeredonlinenetwork.neon",
      "infoPlist": { "UIBackgroundModes": ["audio"] }
    },
    "android": {
      "package": "com.needlesslyengineeredonlinenetwork.neon",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0d12"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      ["expo-audio", { "enableBackgroundPlayback": true }],
      ["expo-splash-screen", { "image": "./assets/splash.png", "imageWidth": 240, "resizeMode": "contain", "backgroundColor": "#0b0d12" }],
      "expo-asset"
    ],
    "experiments": { "typedRoutes": false },
    "extra": {
      "apiUrl": "https://neon-podcasts.vercel.app",
      "webUrl": "https://neon-podcasts.vercel.app"
    }
  }
}

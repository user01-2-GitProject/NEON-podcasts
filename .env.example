# ---- Database (Neon Postgres) ----
# Pooled connection string from the Neon dashboard (or `mcp` provisioning output).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---- Accounts ----
# Comma-separated owner emails; all other accounts are read-only members.
OWNER_EMAILS="you@example.com"
# Secret required once when enrolling an owner account. Keep private from members.
OWNER_SIGNUP_SECRET="change-me-to-a-long-owner-enrollment-secret"
# Auth.js session secret. Use a long random string (32+ characters).
AUTH_SECRET="change-me-to-another-long-random-string"

# Bearer token Vercel sends to protected cron routes.
CRON_SECRET="change-me-to-a-third-long-random-string"

# ---- Script generation ----
# Choose where the script LLM runs: anthropic (default) | openrouter
LLM_PROVIDER="anthropic"

# Option A — Anthropic API directly
ANTHROPIC_API_KEY="sk-ant-..."
# Optional override; defaults to claude-sonnet-5-5
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Option B — OpenRouter (one key reaches Claude, OpenAI, and more)
# Set LLM_PROVIDER=openrouter and fill these:
OPENROUTER_API_KEY=""
# Any model slug from https://openrouter.ai/models (e.g. openai/gpt-4o)
OPENROUTER_MODEL="anthropic/claude-sonnet-4.5"
# Optional attribution shown in your OpenRouter dashboard:
OPENROUTER_SITE_URL="https://neon-podcasts.vercel.app"

# ---- Text to speech ----
# One of: openai | elevenlabs | local
TTS_PROVIDER="openai"

# OpenAI TTS (reuses an OpenAI API plan)
OPENAI_API_KEY="sk-..."
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="alloy"

# ElevenLabs TTS (reuses an ElevenLabs plan)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# Local / self-hosted voices (TTS_PROVIDER=local)
# Any OpenAI-compatible speech endpoint: Kokoro-FastAPI, openedai-speech
# (Piper/Coqui/XTTS), LocalAI, etc. Give the FULL endpoint URL.
# On Vercel, localhost is NOT reachable — run the app locally or expose the
# engine at a reachable URL (tunnel / self-host).
LOCAL_TTS_URL="http://localhost:8000/v1/audio/speech"
LOCAL_TTS_MODEL="tts-1"
LOCAL_TTS_VOICE="alloy"
# Optional, only if your local server requires a key:
LOCAL_TTS_API_KEY=""

# ---- Episode audio storage ----
# Omit or use "db" to keep audio in the episode_audio Postgres table.
# For Cloudflare R2 or AWS S3, set STORAGE_PROVIDER=s3 and provide:
STORAGE_PROVIDER="db"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional: public object base URL. Omit to serve through the app audio route.
S3_PUBLIC_BASE_URL=""
# Optional for AWS-compatible endpoints; R2 uses "auto" by default.
S3_REGION=""

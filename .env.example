# ---- Database (Neon Postgres) ----
# Pooled connection string from the Neon dashboard (or `mcp` provisioning output).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---- Single-user auth gate ----
# The password you type on the /login page to reach the dashboard.
APP_PASSWORD="change-me-to-a-long-random-string"
# Secret used to sign the session cookie. Any long random string.
AUTH_SECRET="change-me-to-another-long-random-string"

# ---- Script generation (Claude API) ----
ANTHROPIC_API_KEY="sk-ant-..."
# Optional override; defaults to claude-sonnet-5-5
ANTHROPIC_MODEL="claude-sonnet-5-5"

# ---- Text to speech ----
# One of: openai | elevenlabs
TTS_PROVIDER="openai"

# OpenAI TTS (reuses an OpenAI API plan)
OPENAI_API_KEY="sk-..."
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="alloy"

# ElevenLabs TTS (reuses an ElevenLabs plan)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
